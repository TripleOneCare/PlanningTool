# TOC Planning Tool - sample nginx (LEMP) server block
# Adjust server_name, root and the PHP-FPM socket to match your server.
server {
    listen 443 ssl http2;
    server_name planning.tripleonecare.online;
    root /var/www/toc-planning-tool;
    index index.php;

    # ssl_certificate     /etc/letsencrypt/live/planning.tripleonecare.online/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/planning.tripleonecare.online/privkey.pem;

    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header X-Robots-Tag "noindex, nofollow" always;
    add_header Strict-Transport-Security "max-age=31536000" always;

    # Block config, app code, docs and dotfiles
    location ~ ^/(config\.php|config\.sample\.php|cron\.php|README\.md|nginx\.conf\.sample)$ { deny all; return 404; }
    location ^~ /app/ { deny all; return 404; }
    location ~ /\. { deny all; return 404; }

    location / { try_files $uri $uri/ =404; }

    location ~ \.php$ {
        include snippets/fastcgi-php.conf;
        fastcgi_pass unix:/run/php/php8.2-fpm.sock;
    }

    location ~* \.(css|js|svg)$ { expires 30d; access_log off; }
}

server {
    listen 80;
    server_name planning.tripleonecare.online;
    return 301 https://$host$request_uri;
}
